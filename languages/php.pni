 * Named-extract frontend. Workbench execution is host-speed (stdlower / appeval).
 * This module lexes and delegates to the host builtin — same slot as lua.pni.
 */
MODULE PANINI.Frontend.PHP

FUNCTION run_php(source)
    r = PHPRUN(source)
    r.frontend = "PANINI.Frontend.PHP"
    r.bytes = LEN(source)
    RETURN r
END

FUNCTION main()
    r = run_php("<?php\nfunction add($a, $b) {\n  return $a + $b;\n}\necho add(40, 2);\n")
    RETURN r.value
END

END
