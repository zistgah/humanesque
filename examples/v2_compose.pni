@logic
FUNCTION classify(x)
    RETURN x > 0
END

@functional
FUNCTION scale(x)
    RETURN x * 2
END

@imperative
FUNCTION main()
    v = 21
    ok = classify(v)
    IF ok
        RETURN scale(v)
    END
    RETURN 0
END
