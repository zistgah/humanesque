FUNCTION xor1(a, b)
    RETURN (a + b) % 2
END
FUNCTION and1(a, b)
    RETURN a * b
END
FUNCTION main()
    s = xor1(1, 1)
    c = and1(1, 1)
    PRINT c
    RETURN c
END
