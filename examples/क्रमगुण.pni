 * Identifiers are the Devanagari labels of ontology:concept:factorial
 * English name factorial is a VIEW, not the identity.
 */
MODULE क्रमगुण
    FUNCTION क्रमगुण(न)
        IF न <= 1
            RETURN 1
        ELSE
            RETURN न * क्रमगुण(न - 1)
        END
    END
    FUNCTION मुख्य()
        फल = क्रमगुण(6)
        PRINT फल
        RETURN फल
    END
END
