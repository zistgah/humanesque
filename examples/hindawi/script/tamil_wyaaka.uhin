<ஶைலீ வ்யாக>
%அணு
#ஸமாவேஶ <ப்ரகார.ஸ>
#ஸமாவேஶ <மாநகபந.ஸ>
#घோஷணா வ்யாக_ढேர_ப்ரகார द்விगுந
%பூர்ண
 
%மோஹர அஂக
%बாँஏ '+' '-'
%बாँஏ '*' '/'
%बாँஏ '%'
%दாँஏ घடா
 
%%
பஂக்தி   : பஂக்தி உக்தி '\n'   { ம_லிखோ("%g \n", $2); }
       | பஂக்தி '\n'
       | /* ஐபஸிலந */
       ;
உக்தி   : உக்தி '+' உக்தி    { $$ = $1 + $3; }
       | உக்தி '-' உக்தி    { $$ = $1 - $3; }
       | உக்தி '*' உக்தி    { $$ = $1 * $3; }
       | உக்தி '/' உக்தி    { $$ = $1 / $3; }
       | உக்தி '%' உக்தி    { $$ = (int)$1 % (int)$3; }
       | '(' உக்தி ')'     { $$ = $2; }
       | '-' உக்தி %ப்ராथமிகதா घடா  { $$ = - $2; }
       | அஂக
       ;
%%
 
பூர்ணாஂக ஶ_ஶब்द()
அணு
   பூர்ணாஂக ச;
   ஜबதக ( ( ச=அக்ஷர_லோ() ) == ' ' );
   அगர ( (ச == '.') || (ஹை_அஂக(ச)) )
   அணு
      அக்ஷர_வாபஸ(ச, மாநக_நிவேஶ);
      ம_பூछோ("%lf", &ஶ_ब_மாந);
      வாபஸ அஂக;
   பூர்ண
   வாபஸ ச;
பூர்ண
 
பூர்ணாஂக வ்யாக_த்ருடி()
அணு
   வாபஸ 0;
பூர்ண
 
பூர்ணாஂக முख்ய(பூர்ணாஂக தஸ, அக்ஷர *தவ[] )
அணு
   ம_லிखோ("हिंदवी कैल्क्यूलेटर\n");
   ம_லிखோ("Copyright (C) 2003-2023 Abhishek Choudhary\n");
   ம_லிखோ("GNU GPL V2 license. NO WARRANTY.\n");
   ம_லிखோ("आप 0 से 9, +, -, *, / और () का प्रयोग कर सकते हैं।\n");
   வ்யாக();
   வாபஸ 0;
பூர்ண
