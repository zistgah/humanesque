MODULE PANINI.CompilerSource
    IMPORT PANINI.Language

    FUNCTION compile(source:String) -> Map
        tokens = lex(source)
        RETURN {
            success: TRUE,
            token_count: LEN(tokens),
            tokens: tokens
        }
    END

    FUNCTION main() -> Int
        sample = "FUNCTION f(x) RETURN x END"
        result = compile(sample)
        PRINT result.success
        PRINT result.token_count
        ASSERT result.token_count > 0
        RETURN result.token_count
    END
END
