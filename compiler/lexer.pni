MODULE PANINI.Language
    PURPOSE "Stage-1 lexer expressed in PANINI."

    FUNCTION isDigit(ch:String) -> Bool
        RETURN ch >= "0" AND ch <= "9"
    END

    FUNCTION isAlpha(ch:String) -> Bool
        RETURN (ch >= "A" AND ch <= "Z") OR (ch >= "a" AND ch <= "z") OR ch == "_"
    END

    FUNCTION isSpace(ch:String) -> Bool
        RETURN ch == " " OR ch == "\t" OR ch == "\n" OR ch == "\r"
    END

    FUNCTION lex(source:String) -> List
        tokens = []
        i = 0
        n = LEN(source)
        WHILE i < n
            ch = source[i]
            IF isSpace(ch)
                i = i + 1
            ELSE
                IF isDigit(ch)
                    raw = ""
                    WHILE i < n AND isDigit(source[i])
                        raw = raw + source[i]
                        i = i + 1
                    END
                    tokens = tokens + [raw]
                ELSE
                    IF isAlpha(ch)
                        raw = ""
                        WHILE i < n AND (isAlpha(source[i]) OR isDigit(source[i]))
                            raw = raw + source[i]
                            i = i + 1
                        END
                        tokens = tokens + [raw]
                    ELSE
                        tokens = tokens + [ch]
                        i = i + 1
                    END
                END
            END
        END
        RETURN tokens
    END
END
