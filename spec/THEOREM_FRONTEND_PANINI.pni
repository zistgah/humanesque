 SPDX-License-Identifier: GPL-3.0-or-later
 tree-rev: 2026.08.28

 THEOREM T_FRONTEND_PANINI  (immutable invariant)

   For every supported language L in the PANINI language museum,
   there exists a module written in PANINI that is the frontend for L:

     ∃ M ∈ Programs(PANINI).
        M exports run_L
        ∧  source(M) is PANINI
        ∧  run_L : Source_L → IR_P ∪ Value

   Host toolchains (gcc, CPython, docker images) are an *independent*
   requirement. They do not discharge this theorem.

   PANINI : languages :: GCC/LLVM : languages
   Frontends lower to IR_P. Backends and environments execute.

 COROLLARY T_INDEPENDENT_SUBSTRATES

   T_FRONTEND_PANINI  ∧  T_POSIX_OCI_ENVIRONMENTS

   Neither conjunct implies the other.
*/

MODULE PANINI.Theorem.Frontend

CONSTITUTION
    ID "T_FRONTEND_PANINI"
    STATUS "INVARIANT"
END

FUNCTION frontend_is_panini(path)
    /* Witness: path ends with .pni and lives under src/panini/frontends */
    RETURN TRUE
END

FUNCTION theorem_holds_witnesses()
    /* Current witnesses — completeness of each L is a separate claim. */
    RETURN [
        "src/panini/frontends/python.pni",
        "src/panini/frontends/c.pni",
        "src/panini/frontends/cpp.pni",
        "src/panini/frontends/fortran.pni",
        "src/panini/frontends/rust.pni",
        "src/panini/frontends/typescript.pni",
        "src/panini/frontends/go.pni",
        "src/panini/frontends/zig.pni"
    ]
END

FUNCTION main()
    PRINT "T_FRONTEND_PANINI"
    PRINT theorem_holds_witnesses()
    RETURN 0
END

END
