#!/bin/sh
# configure — Hindawi/PANINI local toolchain
# Copyright (C) 1993-2026 Abhishek Choudhary | GPL-3.0-or-later
prefix=/usr/local
cc=gcc
cxx=g++
node=node

for arg in "$@"; do
  case "$arg" in
    --prefix=*) prefix=${arg#--prefix=} ;;
    --with-cc=*) cc=${arg#--with-cc=} ;;
    --with-cxx=*) cxx=${arg#--with-cxx=} ;;
    --with-node=*) node=${arg#--with-node=} ;;
    --help|-h)
      echo "configure [--prefix=DIR] [--with-cc=gcc] [--with-cxx=g++] [--with-node=node]"
      exit 0 ;;
  esac
done

have() { command -v "$1" >/dev/null 2>&1; }

have_flex=no
have "$cc" || { echo "error: C compiler $cc not found" >&2; exit 1; }
have "$node" || { echo "error: node not found (hincc is the driver)" >&2; exit 1; }
have flex && have_flex=yes
have "$cxx" || cxx=$cc

root=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)
cat > "$(dirname "$0")/config.mk" <<EOF
# generated by configure — do not edit
PREFIX=$prefix
CC=$cc
CXX=$cxx
NODE=$node
HAVE_FLEX=$have_flex
PANINI_ROOT=$root
BINDIR=\$(PREFIX)/bin
DATADIR=\$(PREFIX)/share/hindawi
EOF
echo "prefix=$prefix cc=$cc node=$node flex=$have_flex"
echo "wrote dist/hindawi/config.mk"
echo "next: make && make check && make install"
