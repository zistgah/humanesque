/*
 First-class executable values.
*/
FUNCTION identity(x: Any) -> Any
    RETURN x
END

/*
======================================================================
II. PARADIGM COMPOSITION
======================================================================

PANINI permits multiple programming paradigms without making any one
paradigm constitutive.

Functional:
    functions, closures, higher-order values, immutable data, map/filter/reduce

Imperative:
    variables, assignment, sequence, loops, mutation, exceptions

Object-oriented:
    objects, classes, methods, inheritance, composition, interfaces, traits

Declarative:
    rules, constraints, schemas, queries, configuration

Logic:
    predicates, facts, inference, proof obligations

Reactive:
    events, signals, watches, subscriptions

Dataflow:
    streams, pipelines, transformations

Concurrent:
    actors, tasks, futures, parallel blocks, join

Workflow:
    stages, gates, checkpoints, sign-off, iteration, rollback

AI/Agent:
    models, prompts, tools, agents, cognition, planning, evaluation

Artifact/System:
    files, MIME, manifests, provenance, versions, dependencies, release
*/

TRAIT Comparable<T>
    FUNCTION compare(a:T, b:T) -> Int
END

INTERFACE Serializable<T>
    FUNCTION serialize(x:T) -> Bytes
    FUNCTION deserialize(b:Bytes) -> T
END

/*
======================================================================
III. CORE SYNTAX
======================================================================
*/

SYNTAX
    block       := KEYWORD [name] [parameters] BODY END
    expression  := literal | identifier | call | lambda | object | collection
    statement   := declaration | assignment | call | control | block
    comment     := /* ... */ | // ...
    string      := "..."
    list        := [ ... ]
    map         := { key: value, ... }
    lambda      := FUNCTION(parameters) -> Type BODY END
    annotation  := @name[(arguments)]
END

/*
 Explicit control flow.
*/
FUNCTION factorial(n:Int) -> Int
    IF n <= 1
        RETURN 1
    ELSE
        RETURN n * factorial(n - 1)
    END
END

FOR i IN 0..10
    CONTINUE IF i == 5
END

FOREACH item IN collection
    ...
END

WHILE condition
    ...
END

UNTIL condition
    ...
END

REPEAT 3
    ...
END

TRY
    ...
CATCH error
    ...
FINALLY
    ...
END

ASSERT condition
REQUIRE condition
ENSURE condition

/*
 Pattern matching.
*/
MATCH value
    CASE x WHEN predicate(x)
        ...
    CASE _
        ...
END

/*
======================================================================
IV. FUNCTIONS, OBJECTS, DATA, MODULES
======================================================================
*/

FUNCTION compose(f:Function, g:Function) -> Function
    RETURN FUNCTION(x)
        RETURN f(g(x))
    END
END

CLASS ArtifactIndex
    FIELD entries: Map<String, Artifact>

    METHOD add(a:Artifact)
        entries[a.id] = a
    END

    METHOD get(id:String) -> Option<Artifact>
        RETURN entries[id]
    END
END

MODULE Standard
    EXPORT Any, Unit, Bool, Int, Float, String
    EXPORT Function, Object, Data
END

IMPORT Standard

/*
 Modules may be compiled, interpreted, distributed, or embedded.
*/

PACKAGE PANINI.Compiler
PACKAGE PANINI.Runtime
PACKAGE PANINI.StandardLibrary
PACKAGE PANINI.Tools
PACKAGE PANINI.Cyclers
PACKAGE PANINI.AI
PACKAGE PANINI.Verification
PACKAGE PANINI.Provenance
PACKAGE PANINI.Configuration

/*
======================================================================
V. TYPE SYSTEM
======================================================================
*/

TYPE TYPEOF(x:Any) -> Type

TYPE Result<T,E>
    OK(value:T)
    ERR(error:E)
END

TYPE Refinement<T>
    VALUE T
    WHERE Constraint
END

SCHEMA Person
    name: String
    attributes: Map<String,Any>
END

CONSTRAINT positive(x:Int)
    ASSERT x > 0
END

TYPE PositiveInt = Refinement<Int> WHERE x > 0

/*
 Types are inspectable at runtime and compile time.
 Generic types, unions, records, structural interfaces, nominal types,
 dependent/refinement constraints, and schema validation are supported.
*/

/*
======================================================================
VI. DATA / CONFIGURATION AS CODE
======================================================================
*/

CONFIGURATION PANINI_BUILD
    version = "0.1.0"
    target = ["linux-x86_64", "linux-arm64"]
    backend = ["native", "wasm", "container"]
    optimization = "release"
    reproducible = TRUE
END

/*
 A block may itself be a value, configuration, file, or artifact.
*/

FILE "hello.pni"
    MIME "text/x-panini"
    ENCODING "utf-8"
    CONTENT
        FUNCTION main() -> Int
            PRINT "Hello, PANINI"
            RETURN 0
        END
    END
END FILE

FILE "schema.json"
    MIME "application/json"
    CONTENT
        {"type":"object"}
    END
END FILE

FILE "diagram.svg"
    MIME "image/svg+xml"
    CONTENT
        "<svg></svg>"
    END
END FILE

/*
 MIME is semantic, not decorative.
 PANINI may contain text, structured data, source, media references,
 manifests, schemas, binaries, and other typed artifact payloads.
*/

/*
======================================================================
VII. ARTIFACT MODEL
======================================================================
*/

ARTIFACT requirements
    TYPE "specification"
    FORMAT "text/markdown"
    VERSION "1.0.0"
    STATUS DRAFT
    SOURCE "elicitation"
    PROVENANCE
        CREATED_BY "PANINI"
        CREATED_AT NOW
    END
END

DELIVERABLE architecture
    TYPE SPECIFICATION
    FORMAT "text/markdown"
    VERSION "1.0"
    STATUS DRAFT
    DEPENDS_ON requirements
END

ARTIFACT_REVISION architecture
    FROM architecture
    CHANGE "replace transport layer"
    PRESERVE_PROVENANCE TRUE
END

SIGNOFF architecture BY HUMAN
RELEASE architecture VERSION "1.1.0"

CHECKPOINT "architecture-approved"
BASELINE "release-1"
BRANCH "experimental"
DIFF architecture@1.0 architecture@1.1
MERGE "experimental" INTO "main"
SUPERSEDE architecture@1.0 WITH architecture@1.1
ARCHIVE architecture@1.0
RESTORE architecture@1.0

/*
 Artifact state:
   DRAFT -> REVIEW -> APPROVED -> RELEASED -> SUPERSEDED/ARCHIVED

 Every derivation preserves ancestry.
 Every release has a manifest and provenance graph.
*/

/*
======================================================================
VIII. PROVENANCE AND EPISTEMIC STATUS
======================================================================
*/

ENUM EpistemicStatus
    RETRIEVED
    INFERRED
    PROPOSED
    UNRESOLVED
    VERIFIED
    OBSERVED
    SIMULATED
    EXPERIMENTAL
    FALSIFIED
END

CLAIM c
    STATUS RETRIEVED
    SOURCE "authoritative-source"
    EVIDENCE e
END

RULE CANONICAL_OUTPUT
    REQUIRE every_statement.status IS_NOT NULL
    REQUIRE every_statement.provenance IS_NOT NULL
END

/*
 Untagged claims cannot enter canonical output.
 Retrieval and inference are not silently interchangeable.
 Simulation cannot become experiment.
 Proposal cannot become observation.
*/

FUNCTION canonicalize(statement:Claim) -> Result<Claim,Error>
    IF statement.status IS NULL
        RETURN ERR("untagged claim")
    END
    IF statement.provenance IS NULL
        RETURN ERR("missing provenance")
    END
    RETURN OK(statement)
END

/*
======================================================================
IX. QUERY / RETRIEVAL PRIMITIVES
======================================================================
*/

INTERFACE Retriever
    FUNCTION retrieve(query:Query) -> Result<List<Source>,Error>
    FUNCTION read(source:Source) -> Result<Document,Error>
    FUNCTION preserve(source:Source) -> Provenance
END

FUNCTION RETRIEVE(query:Query) -> Result<List<Source>,Error>
    RETURN Runtime.retriever.retrieve(query)
END

FUNCTION READ(source:Source) -> Result<Document,Error>
    RETURN Runtime.retriever.read(source)
END

/*
 The semantic invariant is:
     RETRIEVE -> READ -> INTERPRET -> CORRELATE -> VERIFY
 not:
     GENERATE -> ASSUME -> CLASSIFY -> ASSIGN
*/

/*
======================================================================
X. VERIFICATION / EXPERIMENT
======================================================================
*/

FUNCTION VERIFY(artifact:Artifact, criterion:Constraint) -> Result<Bool,Error>
    ...
END

FUNCTION SIMULATE(system:System, scenario:Scenario) -> Simulation
    ...
END

FUNCTION EXPERIMENT(plan:ExperimentPlan) -> Result<MeasurementSet,Error>
    REQUIRE plan.mode == EXPERIMENTAL
    ...
END

FUNCTION FALSIFY(claim:Claim, tests:List<Test>) -> Result<Claim,Error>
    ...
END

MEASUREMENT m
    VALUE 0.0
    UNIT "unit"
    UNCERTAINTY 0.0
    SOURCE "instrument-or-experiment"
END

RULE EXPERIMENT_GATE
    REQUIRE simulation.status != EXPERIMENTAL
    REQUIRE experiment.evidence EXISTS
END

/*
======================================================================
XI. EVENTS, STATE, REACTIVITY, CONCURRENCY
======================================================================
*/

EVENT ArtifactChanged(artifact:Artifact)

WATCH ArtifactChanged(a)
    INVALIDATE downstream(a)
    RUN affected_tests(a)
END

SIGNAL "requirements-approved"

ON "requirements-approved"
    RUN architecture_cycle
END

PARALLEL
    RUN test_unit
    RUN test_integration
    RUN test_security
JOIN

ACTOR ArtifactManager
    ON ArtifactChanged(a)
        ...
    END
END

/*
 State transition model:
       configuration -> inclination/selection -> act -> execution
       -> observation -> next configuration
*/

/*
======================================================================
XII. WORKFLOW / CYCLE / CYCLER MODEL
======================================================================
*/

TYPE Stage
TYPE Gate
TYPE IterationPolicy
TYPE ExitCondition

CYCLER SoftwareDevelopment
    PURPOSE "Take incomplete intent through verified deliverables."

    STAGE INTENT
        ELICIT user.intent
        CAPTURE concept
        STRUCTURE concept
    END

    STAGE REQUIREMENTS
        ELICIT requirements
        STRUCTURE requirements
        REVIEW requirements
        REVISE requirements
        SIGNOFF requirements
    END

    STAGE ARCHITECTURE
        DERIVE architecture FROM requirements
        REVIEW architecture
        REVISE architecture
        SIGNOFF architecture
    END

    STAGE DESIGN
        DERIVE design FROM architecture
        REVIEW design
        REVISE design
        SIGNOFF design
    END

    STAGE IMPLEMENTATION
        REALIZE implementation FROM design
        TEST implementation
        REVISE implementation
    END

    STAGE VERIFICATION
        VERIFY implementation AGAINST requirements
        VERIFY implementation AGAINST design
    END

    STAGE RELEASE
        PACKAGE
        SIGNOFF
        PUBLISH
        PRESERVE
    END
END

/*
 Cycler semantics are lifecycle semantics, not merely prompt sequencing.
 Prompts are operations inside stages.
*/

/*
 Actual logic is first-class.
*/
AFTER requirements.ITERATIONS >= 3
    GENERATE requirements.summary
    REQUEST HUMAN SIGNOFF
END

UNTIL architecture.status == APPROVED
    REVIEW architecture
    REVISE architecture
END

WHEN deliverable.changed
    RUN affected_tests
    INVALIDATE downstream.artifacts
END

/*
 Resolution is orthogonal to language:
*/
RESOLUTION EASY
RESOLUTION MID
RESOLUTION PRO

/*
======================================================================
XIII. COGNITIVE / AI / AGENT SUBSTRATE
======================================================================
*/

MODEL claude
    PROVIDER "external"
    CAPABILITIES ["language", "reasoning"]
END

MODEL local
    PROVIDER "local"
    RUNTIME "configured-runtime"
END

MODEL user_api
    PROVIDER "user"
    CREDENTIAL ENV("PANINI_MODEL_KEY")
END

PROMPT p
    ROLE "architect"
    INPUT requirements
    OUTPUT architecture
END

FUNCTION ASK(model:Model, prompt:Prompt) -> Result<Message,Error>
    ...
END

AGENT Agent
    MEMORY memory
    MODELS [claude, local]
    TOOLS []
    GOALS []
    POLICY human_sovereignty
END

AGENT SoftwareArchitect
    GOAL "produce verified architecture"
    TOOL repository
    TOOL verifier
    MODEL claude
END

/*
 AI is a computational substrate.
 The workflow/orchestration semantics remain explicit.
 Provider identity is not constitutive of PANINI.
*/

/*
======================================================================
XIV. GENIE — META-CYCLER / AGENCY
======================================================================
*/

META_CYCLER GENIE
    PURPOSE "Bring agency to Synthetiforms and drive complete
             conceptualization and realization of deliverables."

    INVOCATION
        WHEN user.cannot_conceptualize
        WHEN user.is_stuck
        WHEN cross_cycler_composition_required
        WHEN end_to_end_deliverable_drive_required
    END

    OPERATIONS
        CONCEIVE
        OBSERVE
        IMAGINE
        ASSOCIATE
        TRANSFORM
        COMBINE
        CONTRAST
        ABSTRACT
        CONCRETIZE
        NARRATE
        DRAMATIZE
        VISUALIZE
        CHARACTERIZE
        SPATIALIZE
        MUSICALIZE
        EMBODY
        ITERATE
        CRITIQUE
        REMIX
        SERIALIZE
        PUBLISH
    END

    COMPOSE(cyclers...)
    ELEVATE(cycler) -> GENIE
    DESCEND(genie, cycler_category)
    SPLIT(genie) -> List<GENIE>
    MERGE(genies...) -> GENIE
END

/*
 GENIE is not the language.
 GENIE is a native meta-cycler.
 Any cycler may elevate into a GENIE.
 GENIE may descend into one or many cycler categories.
 Multiple GENIE instances may split or merge.
 This supports heterogeneous infrastructure.
*/

/*
 Persistent creative state.
*/
STATE PersistentCreativeState
    unified_semantic_world
    narrative_memory
    aesthetic_memory
    creative_identity
    world_model
END

CYCLE CreativeCognition
    MEMORY
    GENERATIVE_FIELD
    CORRESPONDENCE
    ABSTRACTION
    INTEGRATION
    CRYSTALLIZATION
    REALIZATION
    OBSERVATION
    MEMORY
    RE_EXPANSION
END

/*
 Operational GENIE lifecycle:
*/
CYCLE ResearchArtifact
    DISCOVER
    SPECIFY
    FORMALIZE
    IMPLEMENT
    VERIFY
    SIMULATE
    EXPERIMENT
    FALSIFY
    DOCUMENT
    AUDIT
    REFINE
END

/*
======================================================================
XV. FAKIR — RETRIEVAL-FIRST DOMAINAL GUIDE
======================================================================
*/

CYCLER FAKIR
    PURPOSE "Guide sovereigns through domainal reality and mission."

    METHOD
        RETRIEVE
        READ
        INTERPRET
        CORRELATE
        VERIFY
        EVIDENCE
        GOVERN
        PRESERVE
        GUIDE
        TRANSFORM
    END

    SOURCES
        ISIC "UN economic activity domains"
        ISCO "ILO occupation/work domains"
        ISCED "UNESCO UIS education/learning domains"
        OTHER_ERUDITION
    END

    PRINCIPLE
        RETRIEVE_DONT_RECONSTRUCT
    END

    DOMAIN_MODEL
        ACTIVITY
        WORK
        LEARNING
        ERUDITION
        COMPOSITE_DOMAINS
    END

    FORMATION
        GUIDE epistemological_dukedom
    END

    POST_ABDICATION
        GUIDE mission -> domain(s)
        ALLOW composite_domain
        GUIDE_TO appropriate_varzish
    END
END

/*
 FAKIR retrieves domains, not the classifications as identity.
 FAKIR does not assign a sovereign to a taxonomy.
 It orients domainal terrain.
*/

/*
======================================================================
XVI. CHARBAGH — HUMANESQUE TRIAGE / WAYFINDING
======================================================================
*/

CYCLER CHARBAGH
    PURPOSE "Humanesque triage and wayfinding."

    ARRIVE
    ELICIT
    RETRIEVE
    MAP
    NAVIGATE
    COMPOSE
    DERIVE
    ENTER
    REMEMBER

    ROUTES
        EXISTING_ESTATE
        COMPOSITE_ESTATES
        DERIVE_ESTATES
        INVOKE_GENIE
    END
END

/*
 FAKIR retrieves.
 Charbagh routes.
 GENIE conceives.
*/

/*
======================================================================
XVII. ESTATE / SOVEREIGNTY MODEL
======================================================================
*/

TYPE Sovereign
TYPE Dukedom
TYPE Janapad
TYPE Mahajanapad
TYPE Estate

FUNCTION constituteEstate(
    sovereign:Sovereign,
    retrievedSources:List<Source>,
    configuration:Configuration
) -> Result<Estate,Error>
    REQUIRE all retrievedSources.have_provenance
    REQUIRE human_review == TRUE
    ...
END

/*
 An estate may be derived rather than selected.
 Plural inheritance is representable.
*/

ESTATE Humanesque
    KIND "constitutional/civilizational envelope"
END

ESTATE AyeAI
    KIND "cognitive/technical estate"
END

ESTATE Zistgah
    KIND "living ecosystem / infrastructure estate"
END

