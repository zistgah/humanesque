/*
 One semantic state -> many realizations.
*/

/*
======================================================================
XXI. CEM / SUBSTRATE ABSTRACTION
======================================================================
*/

INTERFACE CEM
    FUNCTION allocate(resource:Resource) -> Result<ResourceHandle,Error>
    FUNCTION execute(task:Task) -> Result<ExecutionResult,Error>
    FUNCTION observe(handle:ResourceHandle) -> Observation
END

/*
 CEM abstracts physical/virtual substrate.
 PANINI semantics do not depend on one machine, runtime, cloud,
 accelerator, model provider, or operating system.
*/

/*
======================================================================
XXII. EXECUTION MODEL
======================================================================
*/

ENUM ExecutionMode
    INTERPRETED
    COMPILED
    JIT
    AOT
    WASM
    CONTAINER
    DISTRIBUTED
END

RUNTIME PANINI_RUNTIME
    MODES [
        INTERPRETED,
        COMPILED,
        JIT,
        AOT,
        WASM,
        CONTAINER,
        DISTRIBUTED
    ]

    COMPONENT LEXER
    COMPONENT PARSER
    COMPONENT AST
    COMPONENT TYPECHECKER
    COMPONENT SEMANTIC_ANALYZER
    COMPONENT IR_LOWERER
    COMPONENT OPTIMIZER
    COMPONENT CODEGEN
    COMPONENT BYTECODE_VM
    COMPONENT SCHEDULER
    COMPONENT EVENT_ENGINE
    COMPONENT ARTIFACT_MANAGER
    COMPONENT PROVENANCE_ENGINE
    COMPONENT VERIFIER
    COMPONENT PACKAGE_MANAGER
    COMPONENT MODEL_ADAPTER
    COMPONENT TOOL_RUNTIME
    COMPONENT FILE_RUNTIME
END

/*
======================================================================
XXIII. SELF-HOSTING COMPILER
======================================================================
*/

TYPE Token
TYPE ASTNode
TYPE IRNode
TYPE MachineCode
TYPE Bytecode

FUNCTION lex(source:String) -> List<Token>
    ...
END

FUNCTION parse(tokens:List<Token>) -> ASTNode
    ...
END

FUNCTION typecheck(ast:ASTNode) -> Result<ASTNode,Error>
    ...
END

FUNCTION lower(ast:ASTNode) -> IRNode
    ...
END

FUNCTION optimize(ir:IRNode) -> IRNode
    ...
END

FUNCTION codegen(ir:IRNode, target:ExecutionMode) -> Bytes
    ...
END

FUNCTION compile(source:String, target:ExecutionMode) -> Artifact
    tokens = lex(source)
    ast = parse(tokens)
    typed = typecheck(ast)
    ir = lower(typed)
    optimized = optimize(ir)
    binary = codegen(optimized, target)
    RETURN Artifact(binary)
END

/*
 Self-hosting bootstrap stages:
    Stage 0: minimal external bootstrap implementation.
    Stage 1: PANINI lexer/parser/AST in PANINI.
    Stage 2: PANINI type checker and semantic analyzer in PANINI.
    Stage 3: PANINI IR/lowering in PANINI.
    Stage 4: PANINI optimizer/code generators in PANINI.
    Stage 5: PANINI compiler compiles PANINI compiler.
    Stage 6: bootstrap compiler becomes self-hosting.
*/

/*
======================================================================
XXIV. CAN PANINI EXPRESS PANINI?
======================================================================
*/

MODULE PANINI.Language
    TYPE Token
    TYPE AST
    TYPE Type
    TYPE Constraint
    TYPE IR
    TYPE Backend
    FUNCTION lex
    FUNCTION parse
    FUNCTION typecheck
    FUNCTION lower
    FUNCTION optimize
    FUNCTION compile
END

MODULE PANINI.CompilerSource
    IMPORT PANINI.Language

    FUNCTION main(source:String, target:ExecutionMode) -> Artifact
        RETURN PANINI.Language.compile(source, target)
    END
END

PROGRAM bootstrap
    source = READ FILE "PANINI.Compiler.pni"
    compiler_artifact = PANINI.CompilerSource.main(source, NATIVE)
    WRITE compiler_artifact TO "build/panini-bootstrap"
END

ASSERT PANINI.CompilerSource CAN_COMPILE PANINI.CompilerSource

/*
 This assertion is the formal answer:
    PANINI can express the language PANINI needs to build PANINI.
*/

/*
======================================================================
XXV. BOOTSTRAP SPECIFICATION
======================================================================
*/

BOOTSTRAP PANINI
    INPUT external_minimal_runtime

    STAGE 0
        BUILD "bootstrap/panini0"
    END

    STAGE 1
        COMPILE "src/panini/lexer.pni"
        COMPILE "src/panini/parser.pni"
        COMPILE "src/panini/ast.pni"
    END

    STAGE 2
        COMPILE "src/panini/typechecker.pni"
        COMPILE "src/panini/semantic.pni"
    END

    STAGE 3
        COMPILE "src/panini/ir.pni"
        COMPILE "src/panini/lowering.pni"
    END

    STAGE 4
        COMPILE "src/panini/optimizer.pni"
        COMPILE "src/panini/backends.pni"
    END

    STAGE 5
        SELF_COMPILE "src/panini/compiler.pni"
    END

    STAGE 6
        COMPARE stage5.output WITH stage5.compiler
        VERIFY bootstrap_consistency
    END
END

