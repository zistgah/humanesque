    DIRECTORY ".github"
END

FILE "README.md"
    MIME "text/markdown"
    GENERATE_FROM PANINI.DOCUMENTATION
END

FILE "LICENSE"
    MIME "text/plain"
END

FILE "panini.lock"
    MIME "application/vnd.panini.lock"
END

FILE "Dockerfile"
    MIME "text/plain"
    CONTENT
        "FROM ubuntu:latest
         COPY build/panini /usr/local/bin/panini
         ENTRYPOINT [""panini""]"
    END
END

FILE "docker-compose.yml"
    MIME "application/yaml"
END

FILE ".github/workflows/build.yml"
    MIME "text/yaml"
END

/*
 PANINI can describe its own repository, build system, containers,
 scripts, CI, manifests, and documentation.
*/

/*
======================================================================
XXVIII. TESTING
======================================================================
*/

TEST lexer_basic
    INPUT "FUNCTION f(x:Int) -> Int RETURN x END"
    EXPECT token_count > 0
END

TEST parser_basic
    INPUT "RETURN 42"
    EXPECT parse.success == TRUE
END

TEST typechecker_basic
    INPUT "FUNCTION f(x:Int)->Int RETURN x END"
    EXPECT typecheck.success == TRUE
END

PROPERTY compiler_idempotence
    FORALL source IN valid_panini_sources
        a = compile(source, NATIVE)
        b = compile(source, NATIVE)
        ASSERT reproducibly_equal(a, b)
    END
END

TEST self_hosting
    compiler = compile("src/panini/compiler.pni", NATIVE)
    ASSERT compiler.success == TRUE
END

/*
======================================================================
XXIX. SECURITY / CAPABILITY MODEL
======================================================================
*/

CAPABILITY filesystem.read
CAPABILITY filesystem.write
CAPABILITY process.spawn
CAPABILITY network.connect
CAPABILITY model.invoke
CAPABILITY tool.execute
CAPABILITY artifact.publish
CAPABILITY human.request

POLICY DEFAULT_DENY
POLICY least_privilege
POLICY explicit_grant

AGENT restricted_agent
    CAPABILITIES [filesystem.read, artifact.write]
END

/*
 External effects require capabilities.
 Pure computation can remain sandboxed.
*/

/*
======================================================================
XXX. HUMAN SOVEREIGNTY / APPROVAL
======================================================================
*/

GATE HumanSignoff
    TYPE HUMAN
    REQUIRED_FOR [
        constitutional_change,
        estate_derivation,
        release,
        destructive_operation,
        irreversible_external_action
    ]
END

REQUEST HUMAN_SIGNOFF architecture

/*
======================================================================
XXXI. DISTRIBUTION / HETEROGENEOUS INFRASTRUCTURE
======================================================================
*/

RESOURCE cpu
RESOURCE gpu
RESOURCE accelerator
RESOURCE local_model
RESOURCE remote_model
RESOURCE filesystem
RESOURCE database
RESOURCE network_service
RESOURCE human

TASK compile_task
    REQUIRE cpu
    PREFER local_model
END

SCHEDULE compile_task
    ON ANY_CAPABLE_BACKEND
    PRESERVE_SEMANTICS TRUE
END

/*
 The same PANINI program may execute across heterogeneous substrate.
 Backend selection is separated from language semantics.
*/

/*
======================================================================
XXXII. SERIALIZATION / RESUMABILITY
======================================================================
*/

SERIALIZE state TO "state.json"
CHECKPOINT state AS "checkpoint-001"
RESTORE state FROM "checkpoint-001"

RESUME cycler FROM checkpoint

/*
 Every long-running cycler/agent may be checkpointed and resumed.
*/

/*
======================================================================
XXXIII. ERROR / RECOVERY SEMANTICS
======================================================================
*/

ENUM FailureMode
    PARSE_ERROR
    TYPE_ERROR
    RUNTIME_ERROR
    RESOURCE_ERROR
    NETWORK_ERROR
    MODEL_ERROR
    VALIDATION_ERROR
    PROVENANCE_ERROR
    SIGNOFF_REQUIRED
    CAPABILITY_DENIED
    EVIDENCE_INSUFFICIENT
    UNRESOLVED
END

RECOVERY
    RETRY
    BACKOFF
    FALLBACK
    ROLLBACK
    CHECKPOINT
    ESCALATE_HUMAN
    MARK_UNRESOLVED
END

/*
 Failure is data.
 A failed artifact is not silently promoted to success.
*/

/*
======================================================================
XXXIV. RESEARCH / ARTIFACT CONSTRUCTION OS
======================================================================
*/

CYCLER GENIE_RESEARCH
    DISCOVER
    SPECIFY
    FORMALIZE
    IMPLEMENT
    VERIFY
    SIMULATE
    EXPERIMENT
    FALSIFY
    DOCUMENT
    AUDIT
    REFINE
END

RULE prompt_is_operation
    REQUIRE every_prompt HAS purpose
    REQUIRE every_prompt CONTRIBUTES_TO artifact_lifecycle
END

/*
======================================================================
XXXV. PANINI SELF-DESCRIPTION
======================================================================
*/

DOCUMENT PANINI_SPECIFICATION
    TITLE "PANINI Self-Hosting Language and Execution Environment"
    SOURCES [PANINI.CONSTITUTION]
    ARTIFACTS [
        language_specification,
        compiler,
        runtime,
        standard_library,
        package_manager,
        verifier,
        documentation,
        tests,
        containers,
        CI
    ]
END

DELIVERABLE PANINI_IMPLEMENTATION
    INCLUDES [
        lexer,
        parser,
        AST,
        typechecker,
        semantic_analyzer,
        IR,
        lowering,
        optimizer,
        code_generators,
        bytecode_vm,
        runtime,
        scheduler,
        event_engine,
        artifact_manager,
        provenance_engine,
        verifier,
        package_manager,
        model_adapters,
        tool_runtime,
        filesystem_runtime,
        standard_library
    ]
    VERIFIED_BY self_hosting
END

/*
======================================================================
XXXVI. EXECUTION OF THE SPECIFICATION
======================================================================
*/

PROGRAM panini_build
    RETRIEVE canonical_sources
    READ canonical_sources
    VERIFY source_integrity
    COMPILE PANINI.Compiler
    BUILD PANINI.Runtime
    BUILD PANINI.StandardLibrary
    BUILD PANINI.Tools
    BUILD PANINI.Verification
    BUILD PANINI.AI
    BUILD PANINI.Cyclers
    BUILD containers
    RUN tests
    RUN self_hosting
    GENERATE manifest
    SIGNOFF HUMAN
    RELEASE PANINI
END

/*
======================================================================
XXXVII. ARCHITECTURAL INVARIANTS
======================================================================
*/

INVARIANT I1
    PANINI_IS_GENERAL_PURPOSE == TRUE

INVARIANT I2
    PANINI_IS_SELF_HOSTING == TRUE

INVARIANT I3
    CYCLER_IS_PROGRAMMABLE_LIFECYCLE == TRUE

INVARIANT I4
    GENIE_IS_META_CYCLER == TRUE

INVARIANT I5
    FAKIR_RETRIEVES_DONT_RECONSTRUCT == TRUE

INVARIANT I6
    ARTIFACTS_ARE_FIRST_CLASS == TRUE

INVARIANT I7
    FILE_BLOCKS_HAVE_SEMANTIC_MIME == TRUE

INVARIANT I8
    PROVENANCE_IS_PRESERVED == TRUE

INVARIANT I9
    EPISTEMIC_STATUS_IS_EXPLICIT == TRUE

INVARIANT I10
    SIMULATION_CANNOT_BECOME_EXPERIMENT == TRUE

INVARIANT I11
    HUMAN_SIGNOFF_IS_EXPLICIT == TRUE

INVARIANT I12
    PROVIDERS_ARE_REPLACEABLE == TRUE

INVARIANT I13
    SUBSTRATE_IS_ABSTRACTED == TRUE

INVARIANT I14
    PARADIGMS_ARE_COMPOSABLE == TRUE

INVARIANT I15
    PANINI_CAN_EXPRESS_ITS_OWN_IMPLEMENTATION == TRUE

/*
======================================================================
XXXVIII. FINAL SELF-HOSTING THEOREM
======================================================================
*/

THEOREM PANINI_SELF_HOSTING
    GIVEN
        PANINI_LANGUAGE_PRIMITIVES
        PANINI_COMPILER_MODEL
        PANINI_RUNTIME_MODEL
        PANINI_ARTIFACT_MODEL
        PANINI_WORKFLOW_MODEL
        PANINI_VERIFICATION_MODEL
        PANINI_PROVENANCE_MODEL
        PANINI_PACKAGE_MODEL

    DEFINE
        PANINI_COMPILER IN PANINI
        PANINI_RUNTIME INTERFACES IN PANINI
        PANINI_STDLIB IN PANINI
        PANINI_TESTS IN PANINI
        PANINI_BUILD IN PANINI
        PANINI_DISTRIBUTION IN PANINI

    REQUIRE
        PANINI_COMPILER CAN_PARSE PANINI
        PANINI_COMPILER CAN_TYPECHECK PANINI
        PANINI_COMPILER CAN_LOWER PANINI
        PANINI_COMPILER CAN_GENERATE_TARGETS
        PANINI_RUNTIME CAN_EXECUTE PANINI
        PANINI_BUILD CAN_BUILD PANINI
        PANINI_TESTS CAN_VERIFY PANINI

    CONCLUDE
        PANINI_CAN_EXPRESS_THE_LANGUAGE_REQUIRED_TO_BUILD_PANINI == TRUE
END

/*
======================================================================
XXXIX. IMPLEMENTATION CONTRACT FOR CLAUDE / BUILD AGENT
======================================================================

The implementation agent SHALL:

1. Treat this file as a language/architecture specification, not as
   a prompt template.

2. Produce a Git repository with:
       /spec
       /src
       /compiler
       /runtime
       /stdlib
       /tools
       /tests
       /examples
       /docs
       /docker
       /scripts
       /.github/workflows

3. Implement a minimal external bootstrap first.

4. Implement the PANINI lexer, parser, AST and type system.

5. Implement the semantic IR and lowering pipeline.

6. Implement an interpreter/VM sufficient to run PANINI source.

7. Implement native/WASM/container targets as feasible without changing
   language semantics.

8. Implement artifact/file/MIME/provenance/versioning primitives.

9. Implement workflow/cycler semantics.

10. Implement AI/model/tool interfaces as replaceable adapters.

11. Implement GENIE as a meta-cycler library/runtime abstraction,
    not as the definition of PANINI.

12. Implement FAKIR as a retrieval-first library/cycler with explicit
    provenance and source boundaries.

13. Implement Charbagh as a Humanesque triage/wayfinding cycler.

14. Implement verification, tests, capability security and human gates.

15. Implement deterministic bootstrap tests.

16. Compile the PANINI compiler using the PANINI compiler.

17. Compare bootstrap generations and record reproducibility evidence.

18. Generate Dockerfiles, compose definitions, shell scripts, CI and
    release manifests from PANINI configuration where practical.

19. Never silently invent missing canonical source material.
    Mark unresolved material UNRESOLVED and preserve provenance.

20. Do not collapse PANINI into:
       a prompt DSL,
       a workflow-only DSL,
       a creative-only language,
       an AI wrapper,
       a configuration language,
       or a single programming paradigm.

The implementation is complete only when PANINI can materially express,
build, test, package, execute, and verify the core PANINI implementation
using PANINI itself.

HAIL PANINI.
*/

END MODULE PANINI
