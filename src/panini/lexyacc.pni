 * tree-rev: 2026.08.28
 * Combined lex+yacc driver for expr and add(a,b).
 */
MODULE PANINI.LexYacc

FUNCTION lyIsDigit(ch)
    RETURN ch >= "0" AND ch <= "9"
END

FUNCTION lyIsAlpha(ch)
    RETURN (ch >= "A" AND ch <= "Z") OR (ch >= "a" AND ch <= "z") OR ch == "_"
END

FUNCTION lyLex(source)
    tokens = []
    i = 0
    n = LEN(source)
    WHILE i < n
        ch = source[i]
        IF ch == " " OR ch == TAB() OR ch == NEWLINE()
            i = i + 1
        ELSE
            IF lyIsDigit(ch)
                raw = ""
                WHILE i < n AND lyIsDigit(source[i])
                    raw = raw + source[i]
                    i = i + 1
                END
                APPEND(tokens, {kind: "NUMBER", value: raw})
            ELSE
                IF lyIsAlpha(ch)
                    raw = ""
                    WHILE i < n AND (lyIsAlpha(source[i]) OR lyIsDigit(source[i]))
                        raw = raw + source[i]
                        i = i + 1
                    END
                    APPEND(tokens, {kind: "IDENT", value: raw})
                ELSE
                    APPEND(tokens, {kind: "PUNCT", value: ch})
                    i = i + 1
                END
            END
        END
    END
    APPEND(tokens, {kind: "EOF", value: ""})
    RETURN tokens
END

FUNCTION lyNew(tokens)
    RETURN {tokens: tokens, i: 0}
END

FUNCTION lyPeek(st)
    IF st.i >= LEN(st.tokens)
        RETURN {kind: "EOF", value: ""}
    END
    RETURN st.tokens[st.i]
END

FUNCTION lyEat(st)
    t = lyPeek(st)
    st.i = st.i + 1
    RETURN t
END

FUNCTION lyAtom(st)
    t = lyPeek(st)
    IF t.kind == "NUMBER"
        lyEat(st)
        RETURN {op: "num", value: INT(t.value)}
    END
    IF t.kind == "IDENT"
        lyEat(st)
        IF lyPeek(st).value == "("
            lyEat(st)
            a = lyExpr(st)
            IF lyPeek(st).value == ","
                lyEat(st)
            END
            b = lyExpr(st)
            IF lyPeek(st).value == ")"
                lyEat(st)
            END
            RETURN {op: "call", name: t.value, left: a, right: b}
        END
        RETURN {op: "id", name: t.value}
    END
    IF t.value == "("
        lyEat(st)
        e = lyExpr(st)
        IF lyPeek(st).value == ")"
            lyEat(st)
        END
        RETURN e
    END
    lyEat(st)
    RETURN {op: "num", value: 0}
END

FUNCTION lyTerm(st)
    left = lyAtom(st)
    WHILE lyPeek(st).value == "*" OR lyPeek(st).value == "/"
        op = lyEat(st).value
        left = {op: "bin", operator: op, left: left, right: lyAtom(st)}
    END
    RETURN left
END

FUNCTION lyExpr(st)
    left = lyTerm(st)
    WHILE lyPeek(st).value == "+" OR lyPeek(st).value == "-"
        op = lyEat(st).value
        left = {op: "bin", operator: op, left: left, right: lyTerm(st)}
    END
    RETURN left
END

FUNCTION lyEval(e)
    IF e.op == "num"
        RETURN e.value
    END
    IF e.op == "bin"
        l = lyEval(e.left)
        r = lyEval(e.right)
        IF e.operator == "+"
            RETURN l + r
        END
        IF e.operator == "-"
            RETURN l - r
        END
        IF e.operator == "*"
            RETURN l * r
        END
        RETURN l / r
    END
    IF e.op == "call"
        IF e.name == "add"
            RETURN lyEval(e.left) + lyEval(e.right)
        END
    END
    RETURN 0
END

FUNCTION lyRun(source)
    ast = lyExpr(lyNew(lyLex(source)))
    RETURN lyEval(ast)
END

FUNCTION main()
    PRINT lyRun("add(40, 2)")
    PRINT lyRun("6*(3+4)")
    RETURN 0
END

END
