/* Expert: Gaussian elimination 3×3  (GATE DA Linear Algebra / EC math)
 *   x + y + z = 6
 *       2y + z = 5
 *            z = 3
 * → x=2 y=1 z=3
 * Copyright (C) 1993-2026 Abhishek Choudhary | GPL-3.0-or-later
 */
FUNCTION gauss3()
    a00 = 1.0
    a01 = 1.0
    a02 = 1.0
    b0 = 6.0
    a10 = 0.0
    a11 = 2.0
    a12 = 1.0
    b1 = 5.0
    a20 = 0.0
    a21 = 0.0
    a22 = 1.0
    b2 = 3.0
    z = b2 / a22
    y = (b1 - a12 * z) / a11
    x = (b0 - a01 * y - a02 * z) / a00
    RETURN INT(x * 100 + y * 10 + z)
END
FUNCTION main()
    RETURN gauss3()
END
