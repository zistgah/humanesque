/* Expert: 2-means on 4 points  (GATE DA unsupervised)
 * (0,0) (0,2) (10,10) (10,12) → two clusters, SSE check via assignments
 * Copyright (C) 1993-2026 Abhishek Choudhary | GPL-3.0-or-later
 */
FUNCTION dist2(x1, y1, x2, y2)
    dx = x1 - x2
    dy = y1 - y2
    RETURN dx * dx + dy * dy
END
FUNCTION assign(x, y, cx0, cy0, cx1, cy1)
    d0 = dist2(x, y, cx0, cy0)
    d1 = dist2(x, y, cx1, cy1)
    IF d0 <= d1
        RETURN 0
    END
    RETURN 1
END
FUNCTION main()
    cx0 = 0
    cy0 = 0
    cx1 = 10
    cy1 = 10
    a0 = assign(0, 0, cx0, cy0, cx1, cy1)
    a1 = assign(0, 2, cx0, cy0, cx1, cy1)
    a2 = assign(10, 10, cx0, cy0, cx1, cy1)
    a3 = assign(10, 12, cx0, cy0, cx1, cy1)
    IF a0 != 0
        RETURN 0
    END
    IF a1 != 0
        RETURN 0
    END
    IF a2 != 1
        RETURN 0
    END
    IF a3 != 1
        RETURN 0
    END
    RETURN 1
END
