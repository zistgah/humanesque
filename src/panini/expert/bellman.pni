/* Expert: Bellman–Ford shortest paths (GATE CS Algorithms / DA graphs)
 * Graph: 0-1:4, 0-2:1, 2-1:1, 1-3:1, 2-3:5  →  0↝3 = 3
 * Copyright (C) 1993-2026 Abhishek Choudhary | GPL-3.0-or-later
 */
FUNCTION relax(d, u, v, w)
    IF d[u] + w < d[v]
        d[v] = d[u] + w
    END
    RETURN d[v]
END
FUNCTION bellman()
    INF = 999
    d = [0, INF, INF, INF]
    eu = [0, 0, 2, 1, 2]
    ev = [1, 2, 1, 3, 3]
    ew = [4, 1, 1, 1, 5]
    k = 0
    WHILE k < 3
        i = 0
        WHILE i < 5
            relax(d, eu[i], ev[i], ew[i])
            i = i + 1
        END
        k = k + 1
    END
    RETURN d[3]
END
FUNCTION main()
    RETURN bellman()
END
