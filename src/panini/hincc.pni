MODULE PANINI.Hincc
FUNCTION stages_hin()
    RETURN ["rmshaili", "acii2cf", "h2c", "gcc"]
END
FUNCTION stages_uhin()
    RETURN ["fixuninum", "iconv_utf16", "uni2acii", "acii2cf", "h2c"]
END
