 * Named-extract frontend. Workbench execution is host-speed (stdlower / appeval).
 * This module lexes and delegates to the host builtin — same slot as lua.pni.
 */
MODULE PANINI.Frontend.CSharp

FUNCTION run_csharp(source)
    n = LEN(source)
    lowered = CSHARPLOWER(source)
    r = run_c(lowered)
    r.frontend = "PANINI.Frontend.CSharp"
    r.lowered = lowered
    r.bytes = n
    RETURN r
END

FUNCTION main()
    r = run_csharp("using System;\nclass Program {\n  static int Main() {\n    int n = 40 + 2;\n    Console.WriteLine(n);\n    return n;\n  }\n}\n")
    RETURN r.value
END

END
