 * Named-extract frontend. Workbench execution is host-speed (stdlower / appeval).
 * This module lexes and delegates to the host builtin — same slot as lua.pni.
 */
MODULE PANINI.Frontend.SQL

FUNCTION run_sql(source)
    r = SQLRUN(source)
    r.frontend = "PANINI.Frontend.SQL"
    r.bytes = LEN(source)
    RETURN r
END

FUNCTION main()
    r = run_sql("CREATE TABLE t (n INT);\nINSERT INTO t VALUES (40);\nSELECT n + 2 FROM t;\n")
    RETURN r.value
END

END
