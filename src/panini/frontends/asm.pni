/* PANINI.Frontend.Asm — GNU as (gas) integer subset for kernel .s.
 * Copyright (C) 1993-2026 Abhishek Choudhary | GPL-3.0-or-later
 * Tokens + mov/add/sub/ret. Not ld. Not ELF.
 */
MODULE PANINI.Frontend.Asm
FUNCTION run_asm(source)
    r = ASRUN(source)
    r.frontend = "PANINI.Frontend.Asm"
    RETURN r
END
FUNCTION main()
    r = run_asm("movl $0, %eax\nret\n")
    RETURN r.value
END
END
