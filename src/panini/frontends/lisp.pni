MODULE PANINI.Frontend.CommonLisp
FUNCTION run_lisp(source)
    r = LISPRUN(source)
    r.frontend = "PANINI.Frontend.CommonLisp"
    RETURN r
END
FUNCTION main()
    r = run_lisp("(+ 1 2)")
    RETURN r.value
END
END
