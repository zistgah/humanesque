 * Named-extract frontend. Workbench execution is host-speed (stdlower / appeval).
 * This module lexes and delegates to the host builtin — same slot as lua.pni.
 */
MODULE PANINI.Frontend.SysML

FUNCTION run_sysml(source)
    r = SYSMLRUN(source)
    r.frontend = "PANINI.Frontend.SysML"
    r.bytes = LEN(source)
    RETURN r
END

FUNCTION main()
    r = run_sysml("package Demo {\n  part def Motor {\n    attribute power : Integer = 40;\n  }\n  constraint def Add { 40 + 2 }\n}\n")
    RETURN r.value
END

END
