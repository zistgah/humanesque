MODULE PANINI.Frontend.Prolog
FUNCTION run_prolog(source)
    r = PROLOGRUN(source)
    r.frontend = "PANINI.Frontend.Prolog"
    RETURN r
END
FUNCTION main()
    r = run_prolog("3 is 3")
    RETURN r.value
END
END
