MODULE PANINI.Frontend.Smalltalk
FUNCTION run_smalltalk(source)
    r = SMALLTALKRUN(source)
    r.frontend = "PANINI.Frontend.Smalltalk"
    RETURN r
END
FUNCTION main()
    r = run_smalltalk("Eval [ 3 + 4 ]")
    RETURN r.value
END
END
