 * Named-extract frontend. Workbench execution is host-speed (stdlower / appeval).
 * This module lexes and delegates to the host builtin — same slot as lua.pni.
 */
MODULE PANINI.Frontend.Octave

FUNCTION run_octave(source)
    r = OCTAVERUN(source)
    r.frontend = "PANINI.Frontend.Octave"
    r.bytes = LEN(source)
    RETURN r
END

FUNCTION main()
    r = run_octave("function r = add(a, b)\n  r = a + b;\nend\nfunction r = main()\n  n = add(40, 2);\n  disp(n);\n  r = n;\nend\n")
    RETURN r.value
END

END
