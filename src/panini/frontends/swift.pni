 * Named-extract frontend. Workbench execution is host-speed (stdlower / appeval).
 * This module lexes and delegates to the host builtin — same slot as lua.pni.
 */
MODULE PANINI.Frontend.Swift

FUNCTION run_swift(source)
    n = LEN(source)
    lowered = SWIFTLOWER(source)
    r = run_c(lowered)
    r.frontend = "PANINI.Frontend.Swift"
    r.lowered = lowered
    r.bytes = n
    RETURN r
END

FUNCTION main()
    r = run_swift("func add(a: Int, b: Int) -> Int {\n  return a + b\n}\nfunc main() -> Int {\n  let n = add(40, 2)\n  print(n)\n  return n\n}\n")
    RETURN r.value
END

END
