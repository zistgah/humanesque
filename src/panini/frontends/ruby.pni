 * SPDX-License-Identifier: GPL-3.0-or-later
 * Named-extract frontend. Workbench execution is host-speed (stdlower / appeval).
 * This module lexes and delegates to the host builtin — same slot as lua.pni.
 */
MODULE PANINI.Frontend.Ruby

FUNCTION run_ruby(source)
    r = RUBYRUN(source)
    r.frontend = "PANINI.Frontend.Ruby"
    r.bytes = LEN(source)
    RETURN r
END

FUNCTION main()
    r = run_ruby("def add(a, b)\n  a + b\nend\nputs add(40, 2)\n")
    RETURN r.value
END

END
