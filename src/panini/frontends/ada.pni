 * Named-extract frontend. Workbench execution is host-speed (stdlower / appeval).
 * This module lexes and delegates to the host builtin — same slot as lua.pni.
 */
MODULE PANINI.Frontend.Ada

FUNCTION run_ada(source)
    n = LEN(source)
    lowered = ADALOWER(source)
    r = run_c(lowered)
    r.frontend = "PANINI.Frontend.Ada"
    r.lowered = lowered
    r.bytes = n
    RETURN r
END

FUNCTION main()
    r = run_ada("function Main return Integer is\n  N : Integer := 40 + 2;\nbegin\n  return N;\nend Main;\n")
    RETURN r.value
END

END
