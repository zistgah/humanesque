MODULE PANINI.Frontend.Make
FUNCTION run_make(source)
    r = MAKERUN(source)
    r.frontend = "PANINI.Frontend.Make"
    RETURN r
END
FUNCTION main()
    r = run_make("all:\n\techo ok\n")
    RETURN r.value
END
END
