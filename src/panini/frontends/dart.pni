 * Named-extract frontend. Workbench execution is host-speed (stdlower / appeval).
 * This module lexes and delegates to the host builtin — same slot as lua.pni.
 */
MODULE PANINI.Frontend.Dart

FUNCTION run_dart(source)
    n = LEN(source)
    lowered = DARTLOWER(source)
    r = run_c(lowered)
    r.frontend = "PANINI.Frontend.Dart"
    r.lowered = lowered
    r.bytes = n
    RETURN r
END

FUNCTION main()
    r = run_dart("int add(int a, int b) {\n  return a + b;\n}\nint main() {\n  var n = add(40, 2);\n  print(n);\n  return n;\n}\n")
    RETURN r.value
END

END
