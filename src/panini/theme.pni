 */
MODULE PANINI.Theme
FUNCTION presets()
    RETURN {
        jazz: {label: "Jazz", primary: TRUE},
        bells: {label: "Bells"},
        estate: {label: "Estate"},
        night: {label: "Night"},
        manuscript: {label: "Manuscript"},
        terminal: {label: "Terminal"},
        contrast: {label: "Contrast"}
    }
END
FUNCTION main()
    p = presets()
    PRINT p.jazz.label
    RETURN p.jazz.primary
END
END
