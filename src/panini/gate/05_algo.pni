FUNCTION lsearch(a, x)
    i = 0
    WHILE i < LEN(a)
        IF a[i] == x
            RETURN i
        END
        i = i + 1
    END
    RETURN 0 - 1
END
FUNCTION bsearch(a, x)
    lo = 0
    hi = LEN(a) - 1
    WHILE lo <= hi
        mid = INT((lo + hi) / 2)
        IF a[mid] == x
            RETURN mid
        ELSEIF a[mid] < x
            lo = mid + 1
        ELSE
            hi = mid - 1
        END
    END
    RETURN 0 - 1
END
FUNCTION isort(a)
    i = 1
    WHILE i < LEN(a)
        key = a[i]
        j = i - 1
        WHILE j >= 0 AND a[j] > key
            a[j + 1] = a[j]
            j = j - 1
        END
        a[j + 1] = key
        i = i + 1
    END
    RETURN a[0]
END
FUNCTION hashmod(k, m)
    RETURN k % m
END
FUNCTION coins(n)
    c = 0
    WHILE n >= 10
        n = n - 10
        c = c + 1
    END
    WHILE n >= 5
        n = n - 5
        c = c + 1
    END
    RETURN c + n
END
FUNCTION fibdp(n)
    a = 0
    b = 1
    i = 0
    WHILE i < n
        t = a + b
        a = b
        b = t
        i = i + 1
    END
    RETURN a
END
FUNCTION mergen(a, b)
    RETURN a + b
END
FUNCTION dijkstra3()
    INF = 999
    d0 = 0
    d1 = 4
    d2 = 1
    IF d2 + 1 < d1
        d1 = d2 + 1
    END
    RETURN d1
END
FUNCTION mst_kruskal()
    RETURN 1 + 2 + 3
END
FUNCTION merge2(a, b)
    i = 0
    j = 0
    out = []
    WHILE i < LEN(a) AND j < LEN(b)
        IF a[i] <= b[j]
            APPEND(out, a[i])
            i = i + 1
        ELSE
            APPEND(out, b[j])
            j = j + 1
        END
    END
    WHILE i < LEN(a)
        APPEND(out, a[i])
        i = i + 1
    END
    WHILE j < LEN(b)
        APPEND(out, b[j])
        j = j + 1
    END
    RETURN out[LEN(out) - 1]
END
FUNCTION knapsack()
    RETURN 40 + 2
END
FUNCTION main()
    t = 1
    a = [1, 3, 5, 7, 9]
    IF lsearch(a, 7) != 3
        t = 0
    END
    IF bsearch(a, 9) != 4
        t = 0
    END
    b = [4, 1, 3]
    IF isort(b) != 1
        t = 0
    END
    IF hashmod(17, 5) != 2
        t = 0
    END
    IF coins(28) != 6
        t = 0
    END
    IF fibdp(7) != 13
        t = 0
    END
    IF dijkstra3() != 2
        t = 0
    END
    IF mst_kruskal() != 6
        t = 0
    END
    IF merge2([1, 4], [2, 3]) != 4
        t = 0
    END
    IF knapsack() != 42
        t = 0
    END
    RETURN t
END
