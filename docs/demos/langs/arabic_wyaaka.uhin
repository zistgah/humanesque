<ش◌َـےلـی व्یاک>
%اَݨـو
#سماवےش <پ्رکار.س>
#سماवےش <مانکپن.س>
#گھـوشھݨا व्یاک_ڈھےر_پ्رکار د्वـیگـون
%پ◌ُـور्ݨ
 
%مـوھر ن٘ک
%باںایـ '+' '-'
%باںایـ '*' '/'
%باںایـ '%'
%داںایـ گھٹا
 
%%
پںک्تـی   : پںک्تـی اُک्تـی '\n'   { م_لـیکھـو("%g \n", $2); }
       | پںک्تـی '\n'
       | /* اَیـپسـیلن */
       ;
اُک्تـی   : اُک्تـی '+' اُک्تـی    { $$ = $1 + $3; }
       | اُک्تـی '-' اُک्تـی    { $$ = $1 - $3; }
       | اُک्تـی '*' اُک्تـی    { $$ = $1 * $3; }
       | اُک्تـی '/' اُک्تـی    { $$ = $1 / $3; }
       | اُک्تـی '%' اُک्تـی    { $$ = (int)$1 % (int)$3; }
       | '(' اُک्تـی ')'     { $$ = $2; }
       | '-' اُک्تـی %پ्راتھمـیکتا گھٹا  { $$ = - $2; }
       | ن٘ک
       ;
%%
 
پ◌ُـور्ݨاںک ش_شب्د()
اَݨـو
   پ◌ُـور्ݨاںک چ;
   جبتک ( ( چ=اَک्شھر_لـو() ) == ' ' );
   اَگر ( (چ == '.') || (ھ◌َـے_ن٘ک(چ)) )
   اَݨـو
      اَک्شھر_वاپس(چ, مانک_نـیवےش);
      م_پ◌ُـوچھـو("%lf", &ش_ب_مان);
      वاپس ن٘ک;
   پ◌ُـور्ݨ
   वاپس چ;
پ◌ُـور्ݨ
 
پ◌ُـور्ݨاںک व्یاک_ت्رـوٹـی()
اَݨـو
   वاپس 0;
پ◌ُـور्ݨ
 
پ◌ُـور्ݨاںک مـوکھ्ی(پ◌ُـور्ݨاںک تس, اَک्شھر *تव[] )
اَݨـو
   م_لـیکھـو("السلام عليكم — ہندوی\n");
   م_لـیکھـو("Copyright (C) 2003-2023 Abhishek Choudhary\n");
   م_لـیکھـو("GNU GPL V2 license. NO WARRANTY.\n");
   م_لـیکھـو("आप 0 से 9, +, -, *, / और () का प्रयोग कर सकते हैं।\n");
   व्یاک();
   वاپس 0;
پ◌ُـور्ݨ
