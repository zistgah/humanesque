<শৈলী ব্যাক>
%অণু
#সমাবেশ <প্ৰ︎কাৰ︎.স>
#সমাবেশ <মানকপন.স>
#ঘোষণা ব্যাক_ঢেৰ︎_প্ৰ︎কাৰ︎ দ্বিগুন
%পূৰ︎্ণ
 
%মোহৰ︎ অংক
%বাঁএ '+' '-'
%বাঁএ '*' '/'
%বাঁএ '%'
%দাঁএ ঘটা
 
%%
পংক্তি   : পংক্তি উক্তি '\n'   { ম_লিখো("%g \n", $2); }
       | পংক্তি '\n'
       | /* ঐপসিলন */
       ;
উক্তি   : উক্তি '+' উক্তি    { $$ = $1 + $3; }
       | উক্তি '-' উক্তি    { $$ = $1 - $3; }
       | উক্তি '*' উক্তি    { $$ = $1 * $3; }
       | উক্তি '/' উক্তি    { $$ = $1 / $3; }
       | উক্তি '%' উক্তি    { $$ = (int)$1 % (int)$3; }
       | '(' উক্তি ')'     { $$ = $2; }
       | '-' উক্তি %প্ৰ︎াথমিকতা ঘটা  { $$ = - $2; }
       | অংক
       ;
%%
 
পূৰ︎্ণাংক শ_শব্দ()
অণু
   পূৰ︎্ণাংক চ;
   জবতক ( ( চ=অক্ষৰ︎_লো() ) == ' ' );
   অগৰ︎ ( (চ == '.') || (হৈ_অংক(চ)) )
   অণু
      অক্ষৰ︎_বাপস(চ, মানক_নিবেশ);
      ম_পূছো("%lf", &শ_ব_মান);
      বাপস অংক;
   পূৰ︎্ণ
   বাপস চ;
পূৰ︎্ণ
 
পূৰ︎্ণাংক ব্যাক_ত্ৰ︎ুটি()
অণু
   বাপস 0;
পূৰ︎্ণ
 
পূৰ︎্ণাংক মুখ্য(পূৰ︎্ণাংক তস, অক্ষৰ︎ *তব[] )
অণু
   ম_লিখো("हिंदवी कैल्क्यूलेटर\n");
   ম_লিখো("Copyright (C) 2003-2023 Abhishek Choudhary\n");
   ম_লিখো("GNU GPL V2 license. NO WARRANTY.\n");
   ম_লিখো("आप 0 से 9, +, -, *, / और () का प्रयोग कर सकते हैं।\n");
   ব্যাক();
   বাপস 0;
পূৰ︎্ণ
