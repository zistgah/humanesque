FUNCTION fact(n)
    IF n <= 1
        RETURN 1
    END
    RETURN n * fact(n - 1)
END
FUNCTION parent(i)
    RETURN (i - 1) / 2
END
FUNCTION main()
    t = 1
    IF fact(5) != 120
        t = 0
    END
    IF parent(5) != 2
        t = 0
    END
    RETURN t
END
