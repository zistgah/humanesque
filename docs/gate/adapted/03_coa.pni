FUNCTION cache_index(addr, nsets)
    RETURN addr - (addr / nsets) * nsets
END
FUNCTION stall(load_use)
    IF load_use != 0
        RETURN 1
    END
    RETURN 0
END
FUNCTION main()
    t = 1
    IF cache_index(10, 4) != 2
        t = 0
    END
    IF stall(1) != 1
        t = 0
    END
    IF stall(0) != 0
        t = 0
    END
    RETURN t
END
