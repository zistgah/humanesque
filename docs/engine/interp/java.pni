MODULE PANINI.Frontend.Java
FUNCTION run_java(source)
    why = JAVAREJECT(source)
    IF why != ""
        RETURN {ok: FALSE, rejected: why, frontend: "PANINI.Frontend.Java"}
    END
    lowered = JAVALOWER(source)
    r = run_c(lowered)
    r.frontend = "PANINI.Frontend.Java"
    r.lowered = lowered
    RETURN r
END
FUNCTION main()
    r = run_java("class T { void f() {} }")
    RETURN r.value
END
END
