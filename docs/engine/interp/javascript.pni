MODULE PANINI.Frontend.JavaScript
FUNCTION run_javascript(source)
    r = TEST262RUN(source)
    IF r.ok
        r.frontend = "PANINI.Frontend.JavaScript"
        RETURN r
    END
    IF r.error
        r.frontend = "PANINI.Frontend.JavaScript"
        RETURN r
    END
    lowered = JSLOWER(source)
    cr = run_c(lowered)
    cr.frontend = "PANINI.Frontend.JavaScript"
    cr.lowered = lowered
    RETURN cr
END
FUNCTION main()
    r = run_javascript("function main(){ return 0; }")
    RETURN r.value
END
END
