MODULE PANINI.Frontend.Haskell
FUNCTION run_haskell(source)
    r = HASKELLRUN(source)
    r.frontend = "PANINI.Frontend.Haskell"
    RETURN r
END
FUNCTION main()
    r = run_haskell("main = print (1+2)")
    RETURN r.value
END
END
