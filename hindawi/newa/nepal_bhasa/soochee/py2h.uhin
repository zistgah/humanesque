%%

\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}                                                                  
and       {printf("మరియు");}
as       {printf("వంటి");}
assert       {printf("చాటుకోవడం");}
async       {printf("అసమకాలీక");}
await       {printf("ఎదురు");}
break       {printf("𑐬𑑀𑐎");}
class       {printf("व𑐬𑑂𑐐");}
continue       {printf("𑐖𑐵𑐬𑐷");}
def       {printf("నిర్వచించు");}
del       {printf("తొలగించు");}
elif       {printf("వేరే_ఉంటే");}
else       {printf("𑐀𑐣𑑂𑐫𑐠𑐵");}
except       {printf("తప్ప");}
exec       {printf("అమలుపరచు");}
false       {printf("తప్పు");}
finally       {printf("చివరకు");}
for       {printf("𑐮𑐵𑐐𑐶");}
from       {printf("నుండి");}
global       {printf("ప్రపంచ");}
if       {printf("𑐫𑐡𑐶");}
import       {printf("దిగుమతి");}
in       {printf("లో");}
is       {printf("ఉంది");}
None       {printf("ఏమీకాదు");}
nonlocal       {printf("స్థానికం_కానిది");}
not       {printf("కాదు");}
or       {printf("లేదా");}
pass       {printf("ఉతీర్ణత");}
print       {printf("ముద్రించు");}
raise       {printf("పెంచు");}
return       {printf("𑐦𑐬𑑂𑐎𑐵𑐅");}
true       {printf("నిజం");}
try       {printf("ప్రయత్నించు");}
while       {printf("𑐖𑐧𑐳𑐩𑑂𑐩");}
with       {printf("తో");}
yield       {printf("దిగుబడి");}
%%

