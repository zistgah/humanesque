<شیلی گرو>
#شامل <معیاری.س>

/* ساخت، اشارے اور صف — structs, pointers and arrays */

ساخت طالبعلم {
	حرف نام[40];
	صحیح نمبر;
};

خالی بڑھاؤ(ساخت طالبعلم *ط, صحیح ز)
{
	ط->نمبر = ط->نمبر + ز;
}

صحیح مرکزی()
{
	ساخت طالبعلم جماعت[3];
	صحیح ک;
	صحیح مجموعہ = 0;

	برائے(ک=0; ک<3; ک++) {
		لکھو("طالبعلم %d کا نمبر: ", ک+1);
		پڑھو("%d", &جماعت[ک].نمبر);
		بڑھاؤ(&جماعت[ک], 5);
		مجموعہ = مجموعہ + جماعت[ک].نمبر;
	}
	لکھو("مجموعہ = %d، اوسط = %d\n", مجموعہ, مجموعہ/3);
	واپس 0;
}
